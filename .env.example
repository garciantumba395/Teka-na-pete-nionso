# Copie ce fichier en .env.local et remplis les valeurs. Ne commite JAMAIS .env.local (il est dans .gitignore).
# Aucune valeur n'est fournie ici : les clés sont créées par toi, chez chaque fournisseur.

# --- Couche de données -------------------------------------------------------------------------
# fake = démonstration en mémoire (interdit en production) ; pg = PostgreSQL
DATA_LAYER=
# Connexion DIRECTE à PostgreSQL (pas le pooler en mode transaction) pour les migrations ; le pooler convient à l'appli.
DATABASE_URL=
# Certificat de l'hébergeur (PEM) pour une vérification TLS complète. Ne jamais désactiver la vérification.
DATABASE_CA_CERT=
DATABASE_POOL_MAX=
# Base de TEST (npm run test:pg) : toujours une base jetable, jamais celle de production.
DATABASE_URL_TEST=

# --- Secrets (24 caractères aléatoires minimum chacun ; différents entre eux et entre environnements) ---
# Dérive les codes de remise. ATTENTION : le changer invalide les codes des commandes en cours.
HANDOVER_SECRET=
# Protège les codes SMS stockés (HMAC).
OTP_SECRET=
# Protège les routes /api/internal/jobs/* (tâches planifiées). Sans elle, ces routes sont fermées.
CRON_SECRET=

# --- Paiement mobile money ------------------------------------------------------------------------
# fake (bac à sable intégré, interdit en production) ou le nom d'un fournisseur une fois son adaptateur écrit.
PAYMENT_PROVIDER=
# Secret de signature des webhooks du fournisseur.
PSP_WEBHOOK_SECRET=
# Les clés propres au fournisseur choisi (API, identifiants marchands) seront ajoutées ici avec son adaptateur.

# --- SMS (codes de connexion) -----------------------------------------------------------------------
# console (développement, interdit en production) ou le nom d'un fournisseur une fois son adaptateur écrit.
SMS_PROVIDER=

# --- Développement seulement (refusés en production) --------------------------------------------------
# Code SMS fixe pour la démonstration.
DEV_FIXED_OTP=
SMS_CONSOLE_QUIET=
ALLOW_FAKE_PAYMENTS=
